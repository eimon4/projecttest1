PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/office_procurement
DATABASE_SSL=false
# Set to false if connecting to cloud PostgreSQL services (e.g., Render) with self-signed SSL certs
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Exact browser origin; change to http://YOUR_SERVER_LAN_IP:5173 for office development.
APP_ORIGIN=http://localhost:5173
SESSION_HOURS=8
# Set true only behind exactly one trusted reverse proxy in production.
TRUST_PROXY=false
COMPANY_NAME=Your Company
COMPANY_ADDRESS=Your office address
